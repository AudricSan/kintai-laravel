{
    "name": "kintai/bundle-resignation-report",
    "description": "Rapports de démission pour Kintai : rapport de départ d'un employé par magasin (date, motif, préavis, remarques, responsable), avec aperçu et PDF.",
    "type": "library",
    "license": "AGPL-3.0-only",
    "version": "1.0.0",
    "require": {
        "php": "^8.3",
        "kintai/contracts": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Kintai\\Bundles\\ResignationReport\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kintai\\Bundles\\ResignationReport\\ResignationReportServiceProvider"
            ]
        }
    }
}
