    "description": "Échanges de shifts pour Kintai : proposition à un collègue, acceptation, validation par un gérant, échange appliqué par le Core.",
    "type": "library",
    "license": "AGPL-3.0-only",
    "version": "1.0.0",
    "require": {
        "php": "^8.3",
        "kintai/contracts": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Kintai\\Bundles\\ShiftSwap\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kintai\\Bundles\\ShiftSwap\\ShiftSwapServiceProvider"
            ]
        }
    }
}
