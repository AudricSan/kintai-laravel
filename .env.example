# Modèle de variables d'environnement Kintai
# Ces fichiers sont ignorés par git (ne jamais committer les secrets).

# ─── Application ───────────────────────────────────────────────────────────────
APP_NAME=Kintai
APP_ENV=production
APP_DEBUG=false
# URL publique de l'instance (liens des e-mails, p. ex. réinitialisation du mot de passe). Facultatif : l'installateur
# l'enregistre déjà dans les réglages Owner. Si elle est définie ici, elle prime sur ce réglage — ne la décommentez
# qu'avec la vraie adresse publique, jamais une adresse locale.
# APP_URL=https://kintai.example.com
APP_TIMEZONE=Asia/Tokyo
# Langue de l'instance : celle de tous les textes pour les utilisateurs qui n'ont pas choisi la leur dans leur profil.
# Choisie dans l'installateur puis dans les paramètres de l'instance, qui réécrivent cette ligne.
APP_LOCALE=ja

# ─── Driver SMTP (production OVH) ────────────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=noreply@votre-domaine.com
MAIL_FROM_NAME=Kintai
MAIL_HOST=ssl0.ovh.net
MAIL_PORT=465
MAIL_USERNAME=noreply@votre-domaine.com
MAIL_PASSWORD="votre_mot_de_passe_smtp"
MAIL_ENCRYPTION=ssl

# ─── Base de données ──────────────────────────────────────────────────────────
# DB_DRIVER n'est lu que par scripts/provision.php (sqlite|mysql, défaut sqlite).
# Le driver effectif d'une installation déjà faite vit dans config/database.local.php.
DB_DRIVER=sqlite
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_NAME=kintai_session
SESSION_LIFETIME=7200
# Passe automatiquement à true si la requête est en HTTPS.
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# ─── Redis (optionnel, pour les sessions et les files d'attente) ─────────────────────────
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Provisioning CLI (optionnel, scripts/provision.php) ─────────────────────────────
# Utilisé comme repli si les options --admin-* ne sont pas passées en ligne de commande.
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Mise à jour automatique (GitHub Releases) ─────────────────────────────
# Repo public par défaut : pas de token requis. À définir uniquement si le
# dépôt devient privé ou pour lever les limites de l'API GitHub.
GITHUB_UPDATE_REPO=AudricSan/Kintai
GITHUB_UPDATE_TOKEN=

# ─── Signalement de problème (footer → issue GitHub) ───────────────────────
# Jeton avec le scope "public_repo" (ou "repo" si le dépôt est privé), utilisé
# pour créer directement une issue sur GITHUB_UPDATE_REPO depuis le footer.
# Non défini : le formulaire retombe sur un lien github.com/issues/new pré-rempli.
GITHUB_ISSUES_TOKEN=

# ─── Notifications push de l'application mobile (Firebase Cloud Messaging) ────────────────────
# Voir config/push.php pour la procédure complète (projet Firebase, clé de
# compte de service). Chemin relatif à storage/ (déjà entièrement ignoré par
# git) — ne jamais committer ce fichier de credentials.
PUSH_FCM_ENABLED=false
PUSH_FCM_PROJECT_ID=
PUSH_FCM_CREDENTIALS_PATH=

# Les navigateurs (web et PWA) n'utilisent pas FCM : leurs notifications passent par le web push natif, dont les
# clés sont créées automatiquement par l'instance. Rien à configurer ici.

# ─── Licence (déblocage du plan payant) ────────────────────────────────────
# Voir config/license_server.php. Vide : serveur de licence officiel de Kintai (aucun appel réseau tant qu'aucune
# clé de licence n'est saisie). À renseigner seulement pour un serveur de licence privé.
# LICENSE_SERVER_API_KEY identifie le produit "kintai" auprès du serveur de licence, pas la clé de licence du
# client (saisie sur /admin/license).
# LICENSE_SERVER_PUBLIC_KEY_B64 vérifie localement le license_token signé
# (voir LicenseTokenVerifier) — fournie par l'opérateur du serveur de licence,
# jamais la clé privée correspondante.
LICENSE_SERVER_URL=
LICENSE_SERVER_API_KEY=
LICENSE_SERVER_PUBLIC_KEY_B64=

# ─── Autres variables d'environnement personnalisées ───────────────────────────────
# Ajoutez ici d'autres variables d'environnement spécifiques à votre application.
