{
    "name": "kintai/kintai",
    "description": "Open-source shift management system, on Laravel",
    "type": "project",
    "version": "0.2.0",
    "license": "AGPL-3.0-only",
    "require": {
        "php": ">=8.3",
        "erusev/parsedown": "^1.8",
        "guzzlehttp/guzzle": "^8.3",
        "laravel/framework": "^13.19",
        "minishlink/web-push": "^11.0",
        "mpdf/mpdf": "^8.3",
        "phpoffice/phpspreadsheet": "^5.8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "kintai\\Contract\\": "app/Contract/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/helpers.php",
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tests\\Bundles\\DailyReport\\": "bundles/daily-report/tests/",
            "Tests\\Bundles\\HiringReport\\": "bundles/hiring-report/tests/",
            "Tests\\Bundles\\Messaging\\": "bundles/messaging/tests/",
            "Tests\\Bundles\\Notebook\\": "bundles/notebook/tests/",
            "Tests\\Bundles\\PlanningCheck\\": "bundles/planning-check/tests/",
            "Tests\\Bundles\\ResignationReport\\": "bundles/resignation-report/tests/",
            "Tests\\Bundles\\SalaryReport\\": "bundles/salary-report/tests/",
            "Tests\\Bundles\\ShiftClaim\\": "bundles/shift-claim/tests/",
            "Tests\\Bundles\\ShiftSwap\\": "bundles/shift-swap/tests/",
            "Tests\\Bundles\\StorePhoto\\": "bundles/store-photos/tests/",
            "Tests\\Bundles\\TeamDirectory\\": "bundles/team-directory/tests/",
            "Tests\\Bundles\\TimeOff\\": "bundles/timeoff/tests/",
            "Tests\\Bundles\\Timeclock\\": "bundles/timeclock/tests/",
            "kintai\\Bundles\\Installed\\DailyReport\\": "bundles/daily-report/src/",
            "kintai\\Bundles\\Installed\\HiringReport\\": "bundles/hiring-report/src/",
            "kintai\\Bundles\\Installed\\Messaging\\": "bundles/messaging/src/",
            "kintai\\Bundles\\Installed\\Notebook\\": "bundles/notebook/src/",
            "kintai\\Bundles\\Installed\\PlanningCheck\\": "bundles/planning-check/src/",
            "kintai\\Bundles\\Installed\\ResignationReport\\": "bundles/resignation-report/src/",
            "kintai\\Bundles\\Installed\\SalaryReport\\": "bundles/salary-report/src/",
            "kintai\\Bundles\\Installed\\ShiftClaim\\": "bundles/shift-claim/src/",
            "kintai\\Bundles\\Installed\\ShiftSwap\\": "bundles/shift-swap/src/",
            "kintai\\Bundles\\Installed\\StorePhoto\\": "bundles/store-photos/src/",
            "kintai\\Bundles\\Installed\\TeamDirectory\\": "bundles/team-directory/src/",
            "kintai\\Bundles\\Installed\\TimeOff\\": "bundles/timeoff/src/",
            "kintai\\Bundles\\Installed\\Timeclock\\": "bundles/timeclock/src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.32"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
